# =============================================================================
# PipelineHQ — Environment Variables
# Copy this file to .env.local and fill in the values
# =============================================================================

# Database (Neon / Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/pipelinehq

# Auth (Meta OAuth for Threads)
META_CLIENT_ID=
META_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# AI (OpenAI)
OPENAI_API_KEY=

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QStash (Upstash)
QSTASH_TOKEN=

# Stripe
STRIPE_WEBHOOK_SECRET=

# Monitoring
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=

# Email (optional)
RESEND_API_KEY=
